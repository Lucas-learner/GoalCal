# Local development only. Never copy a production database into this file.
GOALCAL_PRODUCTION=false
GOALCAL_DB_URL=sqlite:///./var/development/goalcal.db
GOALCAL_GATEWAY_PORT=8517
GOALCAL_ROOT_APP=1
GOALCAL_OPEN_REGISTRATION=0
GOALCAL_LEGACY_UI=0
GOALCAL_TZ=Asia/Shanghai
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3
# Optional per-layer overrides: LLM_MODEL_TURN / PLAN, LLM_BASE_URL_TURN / PLAN,
# LLM_API_KEY_TURN / PLAN. Memory model routing is reserved, not an active feature.
