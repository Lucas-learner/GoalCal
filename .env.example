# 复制为 .env 后填写；.env 不要提交到 git
# 仅本机开发；生产请使用 .env.production.example 和绝对数据库路径
GOALCAL_PRODUCTION=false
GOALCAL_DB_URL=sqlite:///./goalcal.db

# 用户时区（IANA 名称）
GOALCAL_TZ=Asia/Shanghai

# LLM（SiliconFlow 走 OpenAI 兼容接口）
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3
# 没有 key 时自动回落到规则解析器，方便离线开发
LLM_ENABLED=true
