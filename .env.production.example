# Copy only when provisioning a new instance; keep real secrets out of Git.
GOALCAL_PRODUCTION=true
# Replace with this host's ABSOLUTE path.
GOALCAL_DB_URL=sqlite:////Users/macmini/projects/GoalCal/var/production/goalcal.db
GOALCAL_GATEWAY_PORT=8521
GOALCAL_ROOT_APP=1
GOALCAL_OPEN_REGISTRATION=1
GOALCAL_LEGACY_UI=0
GOALCAL_TZ=Asia/Shanghai
# Optional session lifetime in days (1-365, default 30 with 24h sliding renewal)
# GOALCAL_SESSION_DAYS=30
GOALCAL_AI_DAILY_LIMIT=30
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3
# Optional overrides: LLM_MODEL_TURN / PLAN, LLM_BASE_URL_TURN / PLAN,
# LLM_API_KEY_TURN / PLAN. Existing deployment keeps its configured model/key.

# Optional Calendar Sync V2.2 secrets (CalDAV works without OAuth keys;
# if GOALCAL_CREDENTIAL_KEY is unset in production, a 0600 .credential_key
# file is created next to the database file).
GOALCAL_CREDENTIAL_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Optional public base URL for deep links embedded in bidirectional calendar sync events
# GOALCAL_PUBLIC_URL=https://goalcal.zhang.sarl

# Optional SMTP settings for Stage 1 proactive email digests
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=
# SMTP_FROM=GoalCal <noreply@example.com>
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
